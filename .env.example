# Inkuna reads inkuna.yaml from INKUNA_CONFIG, else <INKUNA_DATA_DIR>/inkuna.yaml,
# else the OS user config directory (see examples/inkuna.yaml)
# and lets the process environment override any value. Copy only the values
# you need into your shell profile or application launcher. Secrets belong in
# the OS keychain (inkunactl setup); environment values override the keychain.
INKUNA_DATA_DIR=
INKUNA_CONFIG=
INKUNA_ORCHESTRATOR_RUNTIME=claude
INKUNA_ORCHESTRATOR_MODEL=
INKUNA_MAX_TASKS=3
INKUNA_DESKTOP_NOTIFICATIONS=true
LINEAR_API_KEY=
INKUNA_LINEAR_ENDPOINT=https://api.linear.app/graphql
INKUNA_LINEAR_TIMEOUT=15s
INKUNA_HEALTH_TIMEOUT=3s
INKUNA_AUTHENTICATION_TIMEOUT=5m
INKUNA_MAX_CONCURRENCY=2
INKUNA_PLANNING_TIMEOUT=5m
INKUNA_WORKER_TIMEOUT=30m
INKUNA_VERIFIER_TIMEOUT=15m
INKUNA_APPROVAL_TIMEOUT=15m
INKUNA_CHECK_LOG_BYTES=1048576
INKUNA_CODEX_BINARY=codex
INKUNA_CLAUDE_BINARY=claude
INKUNA_COPILOT_BINARY=copilot
INKUNA_GIT_BINARY=git
INKUNA_GITHUB_BINARY=gh
INKUNA_GITHUB_HOST=github.com
INKUNA_GITHUB_GIT_PROTOCOL=https
INKUNA_GO_BINARY=go
INKUNA_NODE_BINARY=node
INKUNA_NPM_BINARY=npm
INKUNA_STAGE_DIRECTORIES=
# macOS: the folder inkunactl install puts Inkuna.app in, instead of /Applications.
INKUNA_APPLICATIONS_DIR=
